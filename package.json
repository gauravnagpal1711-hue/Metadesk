{
  "name": "meta-ads-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Meta ads control room: creative studio, campaign management, lead funnel, WhatsApp.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix client install --no-audit --no-fund && npm --prefix client run build",
    "start": "node server/index.js",
    "postinstall": "node scripts/postinstall.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "patch-package": "^8.0.1",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode": "^1.5.4"
  }
}
